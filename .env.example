# Set to "1" to enable FUSE integration tests
RUN_FUSE_INTEGRATION=1
RUN_FUSE_INTEGRATION_INTERACTIVE=0

# Absolute path to the mount point — must have blackhole already mounted on it before running the tests
BLACKHOLE_MOUNT_PATH=/mnt/blackhole

# Name of the source file (relative to mount root) used for read/write tests
BLACKHOLE_SOURCE_FILE_NAME=file.txt

# Expected contents of the source file when read through the mount
BLACKHOLE_SOURCE_CONTENTS=hello world

# Name of a transient file used to test touch-without-persist behaviour (optional, default: transient-check.txt)
BLACKHOLE_TRANSIENT_FILE=transient-check.txt
